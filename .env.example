# ── Supabase (leave empty to run in DEMO MODE with an in-memory store) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for public booking RPCs & storage uploads. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (SEO metadata, links in notifications)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign the demo-mode session cookie (any long random string)
DEMO_SESSION_SECRET=change-me-to-a-long-random-string
# Demo mode is refused in production unless explicitly allowed
ALLOW_DEMO_MODE=false

# ── Future notification providers (architecture ready, disabled by default) ──
NOTIFY_EMAIL_PROVIDER=        # e.g. resend
RESEND_API_KEY=
NOTIFY_WHATSAPP_PROVIDER=     # e.g. twilio | meta
NOTIFY_SMS_PROVIDER=          # e.g. twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
